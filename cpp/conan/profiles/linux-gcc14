{% set cc = "/opt/rh/gcc-toolset-14/root/usr/bin/gcc" %}
{% set cxx = "/opt/rh/gcc-toolset-14/root/usr/bin/g++" %}
[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=14
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=Release

[conf]
tools.build:jobs=8
tools.cmake.cmaketoolchain:generator={{ os.getenv("CMAKE_GENERATOR", "Unix Makefiles") }}
tools.build:compiler_executables={"c": "{{ cc }}", "cpp": "{{ cxx }}"}

[replace_tool_requires]
cmake/*: cmake/system

[platform_tool_requires]
cmake/system
