@PACKAGE_INIT@
include("@PACKAGE_TENSORACLE_HELPER_DIR@/TensoracleCubinPlugin.cmake")
if(NOT TARGET tensoracle::tensoracle)
@TENSORACLE_STATIC_DEPENDENCIES@    if(NOT TARGET TensorRT::nvinfer)
        find_package(TensorRT QUIET CONFIG)
    endif()
    if(TARGET TensorRT::nvinfer)
        set(_tensoracle_nvinfer TensorRT::nvinfer)
        get_target_property(_tensoracle_nvinfer_type TensorRT::nvinfer TYPE)
        if(_tensoracle_nvinfer_type STREQUAL "INTERFACE_LIBRARY")
            # CMakeDeps exposes its per-configuration library directories here.
            set(_tensoracle_nvinfer_dirs
                "$<TARGET_GENEX_EVAL:TensorRT::nvinfer,$<TARGET_PROPERTY:TensorRT::nvinfer,INTERFACE_LINK_DIRECTORIES>>")
        else()
            set(_tensoracle_nvinfer_dirs "$<TARGET_FILE_DIR:TensorRT::nvinfer>")
        endif()
    else()
        # Native SDKs use a host library. Wheels can use the separate TensorRT
        # distribution beside tensoracle; no build-machine path is recorded here.
        find_library(TENSORACLE_TENSORRT_LIBRARY NAMES nvinfer libnvinfer.so.11
            HINTS "${TENSORRT_ROOT}" "$ENV{TENSORRT_ROOT}"
                "${CMAKE_CURRENT_LIST_DIR}/../../../../../tensorrt_libs"
            PATH_SUFFIXES lib lib64 lib/x86_64-linux-gnu)
        if(NOT TENSORACLE_TENSORRT_LIBRARY OR NOT EXISTS "${TENSORACLE_TENSORRT_LIBRARY}")
            set(tensoracle_FOUND FALSE)
            set(tensoracle_NOT_FOUND_MESSAGE
                "TensorRT 11 link library not found. Supply TensorRT::nvinfer through its CMake package, set TENSORRT_ROOT to its installation directory, or set TENSORACLE_TENSORRT_LIBRARY to the full library path.")
            return()
        endif()
        set(_tensoracle_nvinfer "${TENSORACLE_TENSORRT_LIBRARY}")
        get_filename_component(_tensoracle_nvinfer_dirs "${TENSORACLE_TENSORRT_LIBRARY}" DIRECTORY)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/tensoracleTargets.cmake")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND @BUILD_SHARED_LIBS@)
        # Resolve libtensoracle's DT_NEEDED at link time without adding a direct
        # TensorRT dependency to consumers that already rely on its RUNPATH.
        set_property(TARGET tensoracle::tensoracle APPEND PROPERTY
            INTERFACE_LINK_OPTIONS "LINKER:-rpath-link,$<JOIN:${_tensoracle_nvinfer_dirs},:>")
    else()
        set_property(TARGET tensoracle::tensoracle APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES "${_tensoracle_nvinfer}")
    endif()
    unset(_tensoracle_nvinfer)
    unset(_tensoracle_nvinfer_dirs)
    unset(_tensoracle_nvinfer_type)
endif()
check_required_components(tensoracle)
