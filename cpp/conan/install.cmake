include_guard(GLOBAL)

function(tensoracle_install_dependencies profile output_folder)
    # The build requirement is the sole definition of the CLI version.
    if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../pyproject.toml")
        set(metadata "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../pyproject.toml")
    else()
        set(metadata "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../python/pyproject.toml")
    endif()
    file(READ "${metadata}" contents)
    string(REGEX MATCH "conan==([0-9]+\\.[0-9]+\\.[0-9]+)" requirement "${contents}")
    if(NOT requirement)
        message(FATAL_ERROR "Missing exact conan==X.Y.Z build requirement in ${metadata}")
    endif()
    set(version "${CMAKE_MATCH_1}")
    set(TENSORACLE_CONAN_EXECUTABLE "" CACHE FILEPATH "Optional explicit Conan CLI")
    if(TENSORACLE_CONAN_EXECUTABLE)
        set(cli "${TENSORACLE_CONAN_EXECUTABLE}")
    else()
        find_program(cli conan NO_CACHE)
    endif()
    if(cli)
        execute_process(COMMAND "${cli}" --version RESULT_VARIABLE status
            OUTPUT_VARIABLE observed OUTPUT_STRIP_TRAILING_WHITESPACE)
    endif()
    if(NOT cli OR NOT status STREQUAL "0" OR NOT observed STREQUAL "Conan version ${version}")
        message(FATAL_ERROR "${metadata} requires ${requirement}; found '${observed}' (${cli}). Use uv tool install ${requirement}")
    endif()
    set(TENSORACLE_CONAN_CACHE "$ENV{TENSORACLE_CONAN_CACHE}" CACHE PATH "Conan package storage; empty uses the Conan default")
    set(TENSORACLE_CONAN_ARGS "$ENV{TENSORACLE_CONAN_ARGS}" CACHE STRING "Additional Conan install arguments")
    option(TENSORACLE_CONAN_OFFLINE "Use prepared recipes and binaries without exports, remotes or builds" "$ENV{TENSORACLE_CONAN_OFFLINE}")
    set(cache_args)
    if(TENSORACLE_CONAN_CACHE)
        list(APPEND cache_args --core-conf "core.cache:storage_path=${TENSORACLE_CONAN_CACHE}")
    endif()
    # A release container may have no writable HOME.
    if(UNIX AND NOT DEFINED ENV{CONAN_HOME})
        execute_process(COMMAND test -w "$ENV{HOME}" RESULT_VARIABLE unwritable)
        if(unwritable)
            set(ENV{CONAN_HOME} "${output_folder}/home")
        endif()
    endif()
    set(lockfile "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../conan.lock")
    file(READ "${lockfile}" lock)
    if(NOT TENSORACLE_CONAN_OFFLINE)
        # Export and verify the exact revision recorded in the lock.
        string(JSON count LENGTH "${lock}" requires)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON ref GET "${lock}" requires ${index})
            if(ref MATCHES "^(miniz|tensorrt)/([^#]+)#[^%]+")
                set(expected "${CMAKE_MATCH_0}")
                set(recipe_name "${CMAKE_MATCH_1}")
                set(recipe_version "${CMAKE_MATCH_2}")
                execute_process(COMMAND "${cli}" export "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${recipe_name}"
                    --version "${recipe_version}" --format=json ${cache_args}
                    OUTPUT_VARIABLE exported RESULT_VARIABLE status)
                if(NOT status EQUAL 0)
                    message(FATAL_ERROR "Conan export failed for ${expected}")
                endif()
                string(JSON actual GET "${exported}" reference)
                if(NOT actual STREQUAL expected)
                    message(FATAL_ERROR "Local ${recipe_name} recipe ${actual} differs from locked ${expected}; update the lock with the recipe")
                endif()
            endif()
        endforeach()
        set(policies --build=missing --remote conancenter ${TENSORACLE_CONAN_ARGS})
    else()
        set(policies --no-remote --build=never)
    endif()
    execute_process(COMMAND "${cli}" install "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.."
        --lockfile "${lockfile}" --profile:host "${profile}" --profile:build "${profile}"
        --output-folder "${output_folder}" ${policies} ${cache_args}
        RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Conan dependencies are unavailable. Prepare them with: cmake -DTENSORACLE_CONAN_PROFILE=${profile} -DTENSORACLE_CONAN_CACHE=${TENSORACLE_CONAN_CACHE} -P ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/prepare-tests.cmake (CONAN_HOME=$ENV{CONAN_HOME})")
    endif()
endfunction()

function(tensoracle_conan_profile)
    set(default_profile "$ENV{TENSORACLE_CONAN_PROFILE}")
    if(NOT default_profile)
        set(default_profile linux-gcc13)
    endif()
    set(TENSORACLE_CONAN_PROFILE "${default_profile}" CACHE STRING "Conan profile name or absolute path")
    if(IS_ABSOLUTE "${TENSORACLE_CONAN_PROFILE}")
        set(profile "${TENSORACLE_CONAN_PROFILE}")
    else()
        set(profile "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/profiles/${TENSORACLE_CONAN_PROFILE}")
    endif()
    set(TENSORACLE_CONAN_PROFILE_PATH "${profile}" PARENT_SCOPE)
endfunction()
