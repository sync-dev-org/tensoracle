{% set cc = "/opt/rh/gcc-toolset-14/root/usr/bin/gcc" %}
{% set cxx = "/opt/rh/gcc-toolset-14/root/usr/bin/g++" %}
[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=14
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=Release

[options]
cuda-toolkit/*:mode=system

[conf]
user.cuda:root=/usr/local/cuda-13.2
tools.build:jobs=8
tools.build:compiler_executables={"c": "{{ cc }}", "cpp": "{{ cxx }}"}
